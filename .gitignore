# Build output
bin/
obj/
*.user
*.suo
.vs/
packages/

# Third-party binaries referenced from the local HDT install; never commit them
lib/
*.dll
*.exe
*.pdb

# Spike outputs derived from closed-source assemblies (e.g. API dumps); keep local only
spikes/**/out/

# Collected game data (personal, may contain player identifiers)
data/
*.sqlite
*.db
*.parquet

# Python / analysis
__pycache__/
.venv/
.ipynb_checkpoints/

# OS / editor
Thumbs.db
.DS_Store
