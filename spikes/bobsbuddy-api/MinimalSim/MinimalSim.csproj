<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>10</LangVersion>
    <Nullable>disable</Nullable>
    <!-- Directory containing BobsBuddy.dll / BobsBuddy.Common.dll; HearthDb.dll always comes from HdtDir -->
    <HdtDir Condition="'$(HdtDir)' == ''">C:\Program Files\HDT</HdtDir>
    <BobsBuddyDir Condition="'$(BobsBuddyDir)' == ''">$(HdtDir)</BobsBuddyDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BobsBuddy">
      <HintPath>$(BobsBuddyDir)\BobsBuddy.dll</HintPath>
    </Reference>
    <Reference Include="BobsBuddy.Common">
      <HintPath>$(BobsBuddyDir)\BobsBuddy.Common.dll</HintPath>
    </Reference>
    <Reference Include="HearthDb">
      <HintPath>$(HdtDir)\HearthDb.dll</HintPath>
    </Reference>
    <Reference Include="netstandard" />
  </ItemGroup>

</Project>
