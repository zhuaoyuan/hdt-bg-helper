<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>10</LangVersion>
    <Nullable>enable</Nullable>
    <!-- build.ps1 passes the newest app-* directory; this default only matches HDT 1.58.3 -->
    <HdtDir Condition="'$(HdtDir)' == ''">$(LOCALAPPDATA)\HearthstoneDeckTracker\app-1.58.3</HdtDir>
  </PropertyGroup>

  <!-- All HDT-shipped assemblies are compile-time only: HDT loads its own copies at runtime -->
  <ItemGroup>
    <Reference Include="HearthstoneDeckTracker">
      <HintPath>$(HdtDir)\HearthstoneDeckTracker.exe</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BobsBuddy">
      <HintPath>$(HdtDir)\BobsBuddy.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HearthDb">
      <HintPath>$(HdtDir)\HearthDb.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HearthMirror">
      <HintPath>$(HdtDir)\HearthMirror.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(HdtDir)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="netstandard" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
  </ItemGroup>

</Project>
