<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>10</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>ReplaySim</RootNamespace>
    <HdtDir Condition="'$(HdtDir)' == ''">C:\Program Files\HDT</HdtDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(HdtDir)\Newtonsoft.Json.dll</HintPath>
    </Reference>
    <Compile Include="..\..\..\tools\ReplaySim\Hydrator.cs" Link="Hydrator.cs" />
  </ItemGroup>

</Project>
